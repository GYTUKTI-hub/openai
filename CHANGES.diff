+/**
+ * Delay before a `callLLM` retry attempt: exponential backoff with a small
+ * jitter, capped at `maxDelayMs`. Mirrors the formula used by the generation
+ * package's own retry helper so both layers back off the same way.
+ *
+ * Retrying instantly (no delay) was the previous behaviour here — harmless
+ * for a validation failure, but actively counterproductive for a transient
+ * provider error (rate limit, momentary 5xx): hammering the same endpoint
+ * immediately just reproduces the failure. A brief, growing wait gives the
+ * provider a chance to recover before the next attempt.
+ */
+function llmRetryDelayMs(attempt: number, baseDelayMs = 500, maxDelayMs = 8000): number {
+  const exponential = Math.min(maxDelayMs, baseDelayMs * 2 ** Math.max(0, attempt - 1));
+  const jitter = Math.floor(exponential * Math.random() * 0.2);
+  return Math.min(maxDelayMs, exponential + jitter);
+}
+
+function sleep(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
 export async function callLLM<T extends GenerateTextParams>(
   params: T,
   source: string,
